# Copy this file to .env and paste your free NVIDIA NIM key.
# Get one at https://build.nvidia.com - sign in with an email address,
# open any model page, click "Get API Key". No credit card is required.
NVIDIA_API_KEY=

# Optional. Only change these if you know you need to.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# TTS_ENGINE=pyttsx3

# Signing key for login tokens (any long random string).
# Without it, logins are invalidated every time the server restarts.
JWT_SECRET=
